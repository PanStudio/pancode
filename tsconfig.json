{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2022"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"exactOptionalPropertyTypes": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"declaration": false,
		"sourceMap": true,
		"outDir": "./dist",
		"rootDir": "./src",
		"forceConsistentCasingInFileNames": true,
		"isolatedModules": true,
		"allowImportingTsExtensions": false,
		"types": ["node"],
		// Workspace packages resolve to their source, so the checkout's own
		// templates type-check against the SDK without a build. Authors import
		// the SDK as `pancode/sdk/<subpath>`, the root package's exports.
		"paths": {
			"pancode/sdk/*": ["./packages/sdk/src/*/index.ts"],
			"@pancode/sdk/*": ["./packages/sdk/src/*/index.ts"],
			"@pancode/store": ["./packages/store/src/index.ts"],
			"@pancode/store/*": ["./packages/store/src/*/index.ts"],
			"@pancode/scidata": ["./packages/scidata/src/index.ts"],
			"@pancode/scidata/*": ["./packages/scidata/src/*/index.ts"]
		}
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist", "scripts"]
}
