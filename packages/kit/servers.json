				"SPACK_ENV",
				"SPACK_PYTHON",
				"SPACK_ROOT",
				"SPACK_SYSTEM_CONFIG_PATH",
				"SPACK_USER_CACHE_PATH",
				"SPACK_USER_CONFIG_PATH"
			],
			"tools": [
				{
					"name": "spack_env",
					"title": "Spack environment",
					"actionClass": "read",
					"pathArguments": {},
					"inputSchema": {
						"type": "object",
						"properties": {
							"environment": {
								"type": "string",
								"maxLength": 128,
								"pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
								"description": "A named Spack environment whose roots to return. Default: the active environment."
							}
						}
					},
					"annotations": {
						"title": "Spack environment",
						"readOnlyHint": true,
						"destructiveHint": false,
						"idempotentHint": true,
						"openWorldHint": false
					}
				},
				{
					"name": "spack_find",
					"title": "Installed Spack packages",
					"actionClass": "read",
					"pathArguments": {},
					"inputSchema": {
						"type": "object",
						"properties": {
							"spec": {
								"type": "string",
								"maxLength": 256,
								"pattern": "^(?=.*[^ ])(?! *[-.])(?!.* [-.])(?:[A-Za-z0-9@:,.=+~^%_\\[\\] -]|/[a-z0-9]+(?![^ ]))+$",
								"description": "A Spack spec such as `hdf5@1.14 +mpi ^openmpi` or `/abc1234`: at most 256 characters, entries separated by spaces, none beginning with - (write a disabled variant as ~name)."
							},
							"environment": {
								"type": "string",
								"maxLength": 128,
								"pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
								"description": "A named Spack environment; only the specs installed in it are listed."
							}
						}
					},
					"annotations": {
						"title": "Installed Spack packages",
						"readOnlyHint": true,
						"destructiveHint": false,
						"idempotentHint": true,
						"openWorldHint": false
					}
				},
				{
					"name": "spack_info",
					"title": "Spack package info",
					"actionClass": "read",
					"pathArguments": {},
					"inputSchema": {
						"type": "object",
						"properties": {
							"package": {
								"type": "string",
								"maxLength": 128,
								"pattern": "^[a-z0-9][a-z0-9_-]*$",
								"description": "A package name such as `hdf5`."
							}
						},
						"required": ["package"]
					},
					"annotations": {
						"title": "Spack package info",
						"readOnlyHint": true,
						"destructiveHint": false,
						"idempotentHint": true,
						"openWorldHint": false
					}
				},
				{
					"name": "spack_locate",
					"title": "Locate a Spack install",
					"actionClass": "read",
					"pathArguments": {},
					"inputSchema": {
						"type": "object",
						"properties": {
							"spec": {
								"type": "string",
								"maxLength": 256,
								"pattern": "^(?=.*[^ ])(?! *[-.])(?!.* [-.])(?:[A-Za-z0-9@:,.=+~^%_\\[\\] -]|/[a-z0-9]+(?![^ ]))+$",
								"description": "The installed spec whose prefix to return. A Spack spec such as `hdf5@1.14 +mpi ^openmpi` or `/abc1234`: at most 256 characters, entries separated by spaces, none beginning with - (write a disabled variant as ~name). Give spec or package, not both."
							},
							"package": {
								"type": "string",
								"maxLength": 128,
								"pattern": "^[a-z0-9][a-z0-9_-]*$",
								"description": "The package whose recipe directory to return. Give spec or package, not both."
							}
						}
					},
					"annotations": {
						"title": "Locate a Spack install",
						"readOnlyHint": true,
						"destructiveHint": false,
						"idempotentHint": true,
						"openWorldHint": false
					}
				},
				{
					"name": "spack_spec",
					"title": "Concretize a Spack spec",
					"actionClass": "execute",
					"pathArguments": {},
					"inputSchema": {
						"type": "object",
						"properties": {
							"spec": {
								"type": "string",
								"maxLength": 256,
								"pattern": "^(?=.*[^ ])(?! *[-.])(?!.* [-.])(?:[A-Za-z0-9@:,.=+~^%_\\[\\] -]|/[a-z0-9]+(?![^ ]))+$",
								"description": "A Spack spec such as `hdf5@1.14 +mpi ^openmpi` or `/abc1234`: at most 256 characters, entries separated by spaces, none beginning with - (write a disabled variant as ~name)."
							}
						},
						"required": ["spec"]
					},
					"annotations": {
						"title": "Concretize a Spack spec",
						"readOnlyHint": false,
						"destructiveHint": false,
						"idempotentHint": false,
						"openWorldHint": false
					}
				}
			]
		},
		{
			"id": "scidata",
			"version": "0.2.0",
			"title": "Scientific data",
			"environment": [],
			"tools": [
				{
					"name": "scidata_inspect",
					"title": "Inspect a data file",
					"actionClass": "read",
					"pathArguments": {
						"path": "read"
					},
					"inputSchema": {
						"type": "object",
						"properties": {
							"path": {
								"type": "string",
								"minLength": 1,
								"description": "The data file, Zarr store or ADIOS2 .bp directory; relative to the server's working directory or absolute."
							},
							"format": {
								"type": "string",
								"enum": ["csv", "tsv", "json", "jsonl", "hdf5", "netcdf", "parquet", "zarr", "adios2"],
								"description": "The format when the extension or content does not say: csv, tsv, json, jsonl, hdf5, netcdf, parquet, zarr, adios2."
							},
							"variable": {
								"type": "string",
								"description": "HDF5, NetCDF and Zarr: the variable or group path; ADIOS2: the variable name; Parquet stats: the column."
							},
							"delimiter": {
								"type": "string",
								"description": "CSV and TSV: the one delimiter character, or \\t."
							},
							"header": {
								"type": ["boolean", "string"],
								"enum": [true, false, "auto"],
								"description": "CSV and TSV: \"auto\" (default) detects a header row; true or false forces it."
							},
							"sample_rows": {
								"type": "integer",
								"minimum": 0,
								"description": "Rows or top-level members kept as the sample: default 10, at most 1000."
							},
							"max_rows": {
								"type": ["integer", "null"],
								"minimum": 1,
								"description": "Rows scanned before the view becomes sampled: default 100000; null scans the whole file."
							}
						},
						"required": ["path"],
						"additionalProperties": false
					},
					"annotations": {
						"title": "Inspect a data file",
						"readOnlyHint": true,
						"destructiveHint": false,
						"idempotentHint": true,
						"openWorldHint": false
					}
				},
				{
					"name": "scidata_select",
					"title": "Select data values",
					"actionClass": "read",
					"pathArguments": {
						"path": "read"
					},
					"inputSchema": {
						"type": "object",
						"properties": {
							"path": {
								"type": "string",
								"minLength": 1,
								"description": "The data file, Zarr store or ADIOS2 .bp directory; relative to the server's working directory or absolute."
							},
							"format": {
								"type": "string",
								"enum": ["csv", "tsv", "json", "jsonl", "hdf5", "netcdf", "parquet", "zarr", "adios2"],
								"description": "The format when the extension or content does not say: csv, tsv, json, jsonl, hdf5, netcdf, parquet, zarr, adios2."
							},
							"variable": {
								"type": "string",
								"description": "HDF5, NetCDF and Zarr: the variable or group path; ADIOS2: the variable name; Parquet stats: the column."
							},
							"start": {
								"type": "array",
								"items": {
									"type": "integer",
									"minimum": 0
								},
								"minItems": 1,
								"description": "HDF5, NetCDF and Zarr: the 0-based first index per dimension (default 0)."
							},
							"count": {
								"type": "array",
								"items": {
									"type": "integer",
									"minimum": 1
								},
								"minItems": 1,
								"description": "HDF5, NetCDF and Zarr: elements per dimension (default: the rest of each dimension)."
							},
							"stride": {
								"type": "array",
								"items": {
									"type": "integer",
									"minimum": 1
								},
								"minItems": 1,
								"description": "HDF5, NetCDF and Zarr: the step per dimension (default 1)."
							},
							"offset": {
								"type": "integer",
								"minimum": 0,
								"description": "The 0-based first row, record or array element; Parquet stats: the first row."
							},
							"limit": {
								"type": "integer",
								"minimum": 1,
								"description": "Rows returned: default 50, at most 1000; Parquet stats: rows summarized (default all)."
							},
							"columns": {
								"type": "array",
								"items": {
