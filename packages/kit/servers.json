		{
			"id": "modules",
			"version": "0.2.0",
			"title": "Software modules",
			"instructions": "The module tool and MODULEPATH come from the login shell the host was started from; where `module avail` does not work in that shell, every tool reports the module tool missing. No tool loads a module into the caller's environment: modules_plan writes the `module load` lines for a script.",
			"environment": [
				"LMOD_*",
				"LOADEDMODULES",
				"MODULEPATH",
				"MODULESHOME",
				"MODULES_*",
				"_LMFILES_",
				"_ModuleTable*",
				"__LMOD_*",
				"__MODULES_*"
			],
			"tools": [
				{
					"name": "modules_avail",
					"title": "Available modules",
					"actionClass": "read",
					"pathArguments": {},
					"inputSchema": {
						"type": "object",
						"properties": {
							"name": {
								"type": "string",
								"pattern": "^[A-Za-z0-9][A-Za-z0-9_.+/-]*$",
								"maxLength": 128,
								"description": "Only modules whose full name (name/version) matches this, case-sensitively."
							},
							"match": {
								"type": "string",
								"enum": ["prefix", "contains"],
								"description": "Whether name must start the full name or may appear anywhere in it. Default prefix."
							}
						}
					},
					"annotations": {
						"title": "Available modules",
						"readOnlyHint": true,
						"destructiveHint": false,
						"idempotentHint": true,
						"openWorldHint": false
					}
				},
				{
					"name": "modules_collections",
					"title": "Module collections",
					"actionClass": "read",
					"pathArguments": {},
					"inputSchema": {
						"type": "object",
						"properties": {
							"name": {
								"type": "string",
								"pattern": "^[A-Za-z0-9][A-Za-z0-9_.+/-]*$",
								"maxLength": 128,
								"description": "A collection to list the modules of."
							}
						}
					},
					"annotations": {
						"title": "Module collections",
						"readOnlyHint": true,
						"destructiveHint": false,
						"idempotentHint": true,
						"openWorldHint": false
					}
				},
				{
					"name": "modules_list",
					"title": "Loaded modules",
					"actionClass": "read",
					"pathArguments": {},
					"inputSchema": {
						"type": "object",
						"properties": {}
					},
					"annotations": {
						"title": "Loaded modules",
						"readOnlyHint": true,
						"destructiveHint": false,
						"idempotentHint": true,
						"openWorldHint": false
					}
				},
				{
					"name": "modules_plan",
					"title": "Plan module loads",
					"actionClass": "read",
					"pathArguments": {},
					"inputSchema": {
						"type": "object",
						"properties": {
							"modules": {
								"type": "array",
								"minItems": 1,
								"maxItems": 20,
								"items": {
									"type": "string",
									"pattern": "^[A-Za-z0-9][A-Za-z0-9_.+/-]*$",
									"maxLength": 128
								},
								"description": "The modules to load, in the order they should be loaded."
							}
						},
						"required": ["modules"]
					},
					"annotations": {
						"title": "Plan module loads",
						"readOnlyHint": true,
						"destructiveHint": false,
						"idempotentHint": true,
						"openWorldHint": false
					}
				},
				{
					"name": "modules_show",
					"title": "Show a module",
					"actionClass": "read",
					"pathArguments": {},
					"inputSchema": {
						"type": "object",
						"properties": {
							"name": {
								"type": "string",
								"pattern": "^[A-Za-z0-9][A-Za-z0-9_.+/-]*$",
								"maxLength": 128,
								"description": "The module, as name or name/version."
							}
						},
						"required": ["name"]
					},
					"annotations": {
						"title": "Show a module",
						"readOnlyHint": true,
						"destructiveHint": false,
						"idempotentHint": true,
						"openWorldHint": false
					}
				},
				{
					"name": "modules_spider",
					"title": "Search all modules",
					"actionClass": "read",
					"pathArguments": {},
					"inputSchema": {
						"type": "object",
						"properties": {
							"name": {
								"type": "string",
								"pattern": "^[A-Za-z0-9][A-Za-z0-9_.+/-]*$",
								"maxLength": 128,
								"description": "A name, or part of one, to list its versions; or name/version to also get the modules to load first."
							}
						},
						"required": ["name"]
					},
					"annotations": {
						"title": "Search all modules",
						"readOnlyHint": true,
						"destructiveHint": false,
						"idempotentHint": true,
						"openWorldHint": false
					}
				}
			]
		},
		{
			"id": "darshan",
			"version": "0.2.0",
			"title": "Darshan I/O traces",
			"environment": [],
			"tools": [
				{
					"name": "darshan_files",
					"title": "Darshan per-file I/O",
					"actionClass": "read",
					"pathArguments": {
						"path": "read"
					},
					"inputSchema": {
						"type": "object",
						"properties": {
							"path": {
								"type": "string",
								"minLength": 1,
								"maxLength": 4096,
								"pattern": "^[^-\\u0000-\\u001f\\u007f][^\\u0000-\\u001f\\u007f]*$",
								"description": "The Darshan log file (.darshan), relative to the server's working directory. Must not begin with '-'."
							},
							"module": {
								"type": "string",
								"enum": ["POSIX", "MPIIO", "STDIO"],
								"description": "The Darshan module: POSIX, MPIIO (Darshan's MPI-IO) or STDIO. Default POSIX."
							},
							"metric": {
								"type": "string",
								"enum": ["bytesRead", "bytesWritten", "readTime", "writeTime", "metaTime", "opens"],
								"description": "Rank files by bytesRead, bytesWritten, readTime, writeTime, metaTime or opens. Default bytesRead."
							},
							"limit": {
								"type": "integer",
								"minimum": 1,
								"maximum": 100,
								"description": "How many files to return, 1 to 100. Default 20."
							}
						},
						"required": ["path"]
					},
					"annotations": {
						"title": "Darshan per-file I/O",
						"readOnlyHint": true,
						"destructiveHint": false,
						"idempotentHint": true,
						"openWorldHint": false
					}
				},
				{
					"name": "darshan_modules",
					"title": "Darshan module counters",
					"actionClass": "read",
					"pathArguments": {
						"path": "read"
					},
					"inputSchema": {
						"type": "object",
						"properties": {
							"path": {
								"type": "string",
								"minLength": 1,
								"maxLength": 4096,
								"pattern": "^[^-\\u0000-\\u001f\\u007f][^\\u0000-\\u001f\\u007f]*$",
								"description": "The Darshan log file (.darshan), relative to the server's working directory. Must not begin with '-'."
							},
							"module": {
								"type": "string",
								"pattern": "^[A-Z][A-Z0-9_]{0,31}$",
								"description": "The Darshan module, upper case without punctuation: POSIX, MPIIO, STDIO, H5F, H5D, PNETCDF_FILE and so on. Default POSIX."
							}
						},
						"required": ["path"]
					},
					"annotations": {
						"title": "Darshan module counters",
						"readOnlyHint": true,
						"destructiveHint": false,
						"idempotentHint": true,
						"openWorldHint": false
					}
				},
				{
					"name": "darshan_summary",
					"title": "Darshan log summary",
					"actionClass": "read",
					"pathArguments": {
						"path": "read"
					},
					"inputSchema": {
						"type": "object",
						"properties": {
							"path": {
								"type": "string",
								"minLength": 1,
								"maxLength": 4096,
								"pattern": "^[^-\\u0000-\\u001f\\u007f][^\\u0000-\\u001f\\u007f]*$",
								"description": "The Darshan log file (.darshan), relative to the server's working directory. Must not begin with '-'."
							}
						},
						"required": ["path"]
					},
					"annotations": {
						"title": "Darshan log summary",
						"readOnlyHint": true,
						"destructiveHint": false,
						"idempotentHint": true,
						"openWorldHint": false
					}
				},
				{
					"name": "darshan_timeline",
					"title": "Darshan I/O timeline",
					"actionClass": "read",
					"pathArguments": {
						"path": "read"
					},
					"inputSchema": {
						"type": "object",
						"properties": {
							"path": {
								"type": "string",
								"minLength": 1,
								"maxLength": 4096,
								"pattern": "^[^-\\u0000-\\u001f\\u007f][^\\u0000-\\u001f\\u007f]*$",
								"description": "The Darshan log file (.darshan), relative to the server's working directory. Must not begin with '-'."
							},
							"module": {
								"type": "string",
								"enum": ["POSIX", "MPIIO", "STDIO"],
								"description": "The Darshan module: POSIX, MPIIO (Darshan's MPI-IO) or STDIO. Default POSIX."
							}
						},
						"required": ["path"]
					},
					"annotations": {
						"title": "Darshan I/O timeline",
						"readOnlyHint": true,
						"destructiveHint": false,
						"idempotentHint": true,
						"openWorldHint": false
					}
				}
			]
		},
		{
			"id": "spack",
