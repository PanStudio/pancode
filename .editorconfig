# Matches biome.json, which formats and checks the TypeScript, JavaScript, JSON and CSS.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.{ts,tsx,mts,cts,js,mjs,cjs,json,jsonc,css}]
indent_style = tab
max_line_length = 120

[*.{yml,yaml}]
indent_style = space
indent_size = 2
