{
	"id": "darshan",
	"version": "0.2.0",
	"title": "Darshan I/O traces",
	"environment": [],
	"tools": [
		{
			"name": "darshan_files",
			"title": "Darshan per-file I/O",
			"actionClass": "read",
			"pathArguments": {
				"path": "read"
			},
			"inputSchema": {
				"type": "object",
				"properties": {
					"path": {
						"type": "string",
						"minLength": 1,
						"maxLength": 4096,
						"pattern": "^[^-\\u0000-\\u001f\\u007f][^\\u0000-\\u001f\\u007f]*$",
						"description": "The Darshan log file (.darshan), relative to the server's working directory. Must not begin with '-'."
					},
					"module": {
						"type": "string",
						"enum": ["POSIX", "MPIIO", "STDIO"],
						"description": "The Darshan module: POSIX, MPIIO (Darshan's MPI-IO) or STDIO. Default POSIX."
					},
					"metric": {
						"type": "string",
						"enum": ["bytesRead", "bytesWritten", "readTime", "writeTime", "metaTime", "opens"],
						"description": "Rank files by bytesRead, bytesWritten, readTime, writeTime, metaTime or opens. Default bytesRead."
					},
					"limit": {
						"type": "integer",
						"minimum": 1,
						"maximum": 100,
						"description": "How many files to return, 1 to 100. Default 20."
					}
				},
				"required": ["path"]
			},
			"annotations": {
				"title": "Darshan per-file I/O",
				"readOnlyHint": true,
				"destructiveHint": false,
				"idempotentHint": true,
				"openWorldHint": false
			}
		},
		{
			"name": "darshan_modules",
			"title": "Darshan module counters",
			"actionClass": "read",
			"pathArguments": {
				"path": "read"
			},
			"inputSchema": {
				"type": "object",
				"properties": {
					"path": {
						"type": "string",
						"minLength": 1,
						"maxLength": 4096,
						"pattern": "^[^-\\u0000-\\u001f\\u007f][^\\u0000-\\u001f\\u007f]*$",
						"description": "The Darshan log file (.darshan), relative to the server's working directory. Must not begin with '-'."
					},
					"module": {
						"type": "string",
						"pattern": "^[A-Z][A-Z0-9_]{0,31}$",
						"description": "The Darshan module, upper case without punctuation: POSIX, MPIIO, STDIO, H5F, H5D, PNETCDF_FILE and so on. Default POSIX."
					}
				},
				"required": ["path"]
			},
			"annotations": {
				"title": "Darshan module counters",
				"readOnlyHint": true,
				"destructiveHint": false,
				"idempotentHint": true,
				"openWorldHint": false
			}
		},
		{
			"name": "darshan_summary",
			"title": "Darshan log summary",
			"actionClass": "read",
			"pathArguments": {
				"path": "read"
			},
			"inputSchema": {
				"type": "object",
				"properties": {
					"path": {
						"type": "string",
						"minLength": 1,
						"maxLength": 4096,
						"pattern": "^[^-\\u0000-\\u001f\\u007f][^\\u0000-\\u001f\\u007f]*$",
						"description": "The Darshan log file (.darshan), relative to the server's working directory. Must not begin with '-'."
					}
				},
				"required": ["path"]
			},
			"annotations": {
				"title": "Darshan log summary",
				"readOnlyHint": true,
				"destructiveHint": false,
				"idempotentHint": true,
				"openWorldHint": false
			}
		},
		{
			"name": "darshan_timeline",
			"title": "Darshan I/O timeline",
			"actionClass": "read",
			"pathArguments": {
				"path": "read"
			},
			"inputSchema": {
				"type": "object",
				"properties": {
					"path": {
						"type": "string",
						"minLength": 1,
						"maxLength": 4096,
						"pattern": "^[^-\\u0000-\\u001f\\u007f][^\\u0000-\\u001f\\u007f]*$",
						"description": "The Darshan log file (.darshan), relative to the server's working directory. Must not begin with '-'."
					},
					"module": {
						"type": "string",
						"enum": ["POSIX", "MPIIO", "STDIO"],
						"description": "The Darshan module: POSIX, MPIIO (Darshan's MPI-IO) or STDIO. Default POSIX."
					}
				},
				"required": ["path"]
			},
			"annotations": {
				"title": "Darshan I/O timeline",
				"readOnlyHint": true,
				"destructiveHint": false,
				"idempotentHint": true,
				"openWorldHint": false
			}
		}
	]
}
