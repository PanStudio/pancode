{
	"id": "catalog",
	"version": "0.1.0",
	"title": "Dataset catalogs",
	"environment": [],
	"tools": [
		{
			"name": "catalog_describe",
			"actionClass": "read",
			"pathArguments": {},
			"inputSchema": {
				"type": "object",
				"properties": {
					"source": {
						"type": "string",
						"pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
						"description": "The source id from the catalog file."
					},
					"id": {
						"type": "string",
						"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
						"description": "The dataset id, as catalog_search returns it."
					}
				},
				"required": ["source", "id"]
			},
			"annotations": {
				"readOnlyHint": true,
				"destructiveHint": false,
				"idempotentHint": false
			}
		},
		{
			"name": "catalog_search",
			"actionClass": "read",
			"pathArguments": {},
			"inputSchema": {
				"type": "object",
				"properties": {
					"query": {
						"type": "string",
						"pattern": "^[\\p{L}\\p{N}][\\p{L}\\p{N}._-]*( +[\\p{L}\\p{N}][\\p{L}\\p{N}._-]*)*$",
						"maxLength": 200,
						"description": "Words that must all appear in a dataset's title, description or tags; letters, digits, '.', '_' and '-', separated by spaces."
					},
					"source": {
						"type": "string",
						"pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
						"description": "Search only this source id from the catalog file. Default: every source."
					},
					"limit": {
						"type": "integer",
						"minimum": 1,
						"maximum": 50,
						"description": "How many datasets to return, 1 to 50. Default 20."
					},
					"offset": {
						"type": "integer",
						"minimum": 0,
						"maximum": 10000,
						"description": "How many matches to skip, in source order then each source's ranking. Default 0, at most 10000."
					}
				},
				"required": ["query"]
			},
			"annotations": {
				"readOnlyHint": true,
				"destructiveHint": false,
				"idempotentHint": false
			}
		},
		{
			"name": "catalog_stage",
			"actionClass": "execute",
			"pathArguments": {
				"destination": "write"
			},
			"inputSchema": {
				"type": "object",
				"properties": {
					"source": {
						"type": "string",
						"pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
						"description": "The source id from the catalog file."
					},
					"dataset": {
						"type": "string",
						"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
						"description": "The dataset id."
					},
					"resource": {
						"type": "string",
						"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
						"description": "The resource id, as catalog_describe returns it."
					},
					"destination": {
						"type": "string",
						"description": "The file to write, relative to the server's working directory; its directory must exist."
					},
					"overwrite": {
						"type": "boolean",
						"description": "Replace an existing destination file. Default false."
					},
					"maxBytes": {
						"type": "integer",
						"minimum": 1,
						"maximum": 2147483648,
						"description": "Stop and keep nothing past this many bytes. Default and most 2147483648."
					}
				},
				"required": ["source", "dataset", "resource", "destination"]
			},
			"annotations": {
				"readOnlyHint": false,
				"destructiveHint": false,
				"idempotentHint": false
			}
		}
	]
}
