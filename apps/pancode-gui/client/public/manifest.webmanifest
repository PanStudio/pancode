			"src": "/icon-192.png?v=75f8069c1a51",
			"sizes": "192x192",
			"type": "image/png",
			"purpose": "any"
		},
		{
			"src": "/icon-512.png?v=602b9e173353",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "any"
		}
	]
}
