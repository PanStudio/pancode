{
	"id": "/",
	"name": "PanCode",
	"short_name": "PanCode",
	"description": "PanCode on the desktop (alpha): a local workspace in your browser for sessions, usage, artifacts and evidence.",
	"start_url": "/",
	"scope": "/",
	"display": "standalone",
