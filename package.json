{
	"name": "@akougkas/pancode",
	"version": "0.9.0",
	"description": "PanCode is systems software for coding agents. It drives the models you have, sandboxes commands, bounds workers and checks finished work against what ran.",
	"keywords": [
		"coding-agent",
		"agent-harness",
		"ai-agents",
		"agentic-coding",
		"multi-agent",
		"orchestration",
		"llm",
		"local-llm",
		"ollama",
		"vllm",
		"cli",
		"tui",
		"developer-tools",
		"agent-client-protocol",
		"acp",
		"mcp",
		"sandbox",
		"hpc",
		"scientific-computing",
		"research-software"
	],
	"type": "module",
	"license": "SEE LICENSE IN LICENSE",
	"author": "Anthony Kougkas <a.kougkas@gmail.com> (https://github.com/akougkas)",
	"homepage": "https://pancode.dev",
	"bugs": "https://github.com/akougkas/pancode/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/akougkas/pancode.git"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"bin": {
		"pancode": "bin/pancode.cjs",
		"panstore": "dist/store/cli.js",
		"pankit": "dist/kit/cli.js"
	},
	"exports": {
		"./package.json": "./package.json",
		"./sdk/extension": {
			"types": "./dist/sdk/extension.d.ts",
			"import": "./dist/sdk/extension.js"
		},
		"./sdk/pack": {
			"types": "./dist/sdk/pack.d.ts",
			"import": "./dist/sdk/pack.js"
		},
		"./sdk/testing": {
			"types": "./dist/sdk/testing.d.ts",
			"import": "./dist/sdk/testing.js"
		},
		"./sdk/tool": {
			"types": "./dist/sdk/tool.d.ts",
			"import": "./dist/sdk/tool.js"
		},
		"./sdk/mcp-server": {
			"types": "./dist/sdk/mcp-server.d.ts",
			"import": "./dist/sdk/mcp-server.js"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.map",
		"!dist/metafile*.json",
		"!dist/builds",
		"bin/pancode.cjs",
		"scripts/install.sh",
		"scripts/install.ps1",
		"scripts/install.cmd",
		"scripts/native-install.cjs",
		"!assets/README.md",
		"!scripts/README.md",
		"src/**",
		"packages/*/src/**",
		"packages/kit/servers.json",
		"!packages/kit/README.md",
		"!packages/scidata/README.md",
		"!packages/sdk/README.md",
		"!packages/store/README.md",
		"!packages/sdk/LICENSE",
		"tests/fixtures/decision-cases/turn.json",
		"tests/fixtures/decision-cases/worker-prepare.json",
		"tests/fixtures/decision-cases/tool-calls.json",
		"models/**",
		"schemas/*.json",
		"hub/**",
		".claude-plugin/marketplace.json",
		"docs/**/*.md",
		"docs/corpus.json",
		"assets/pancode-mark-gui.webp",
		"assets/windows-launcher/pins.json",
		"assets/windows-launcher/win32-x64/launcher.exe",
		"assets/windows-launcher/win32-arm64/launcher.exe",
		"README.md",
		"CHANGELOG.md",
		"CONTRIBUTING.md",
		"SECURITY.md",
		"CODE_OF_CONDUCT.md",
		"NOTICE",
		"LICENSE",
		"THIRD-PARTY-NOTICES.md",
		"damage-control-rules.yaml",
		"examples/extensions/**"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "node --import tsx scripts/build.ts && node --import tsx scripts/build-source-pack.ts && node --import tsx scripts/build-codewiki-asset.ts && node --import tsx scripts/build-preparsed-yaml.ts",
		"build:release": "node --import tsx scripts/build.ts --clean && node --import tsx scripts/build-source-pack.ts && node --import tsx scripts/build-codewiki-asset.ts && node --import tsx scripts/build-preparsed-yaml.ts",
		"dev": "node --import tsx scripts/build.ts --watch",
		"site:dev": "node site/dev.mjs",
		"clean": "rm -rf dist",
		"check": "node scripts/check.mjs",
		"doctor:dev": "node scripts/doctor-dev.mjs",
		"typecheck": "node scripts/typecheck.mjs",
		"typecheck:tsc": "tsc -p tsconfig.tests.json",
		"typecheck:compare": "node scripts/typecheck-compare.mjs",
		"format": "biome format --write .",
		"lint": "biome check --error-on-warnings . && node --import tsx scripts/check-hygiene.ts",
		"pi:surface-diff": "node --import tsx scripts/pi-surface-diff.ts",
		"pi:surface-snapshot": "node --import tsx scripts/pi-surface-diff.ts --write",
		"acp:schema": "node --import tsx scripts/acp-schema.ts --check",
		"acp:schema:write": "node --import tsx scripts/acp-schema.ts --write",
		"acp:schema:bump": "node --import tsx scripts/acp-schema.ts --bump",
		"herdr:pin": "node --import tsx scripts/herdr-pin.ts",
		"test:file": "node --import tsx --import ./tests/harness/tmp-root.ts --test",
		"test": "node scripts/ci-tests.mjs core",
		"test:gui": "node scripts/ci-tests.mjs gui",
		"test:list": "node scripts/ci-tests.mjs list",
		"check:lane": "node scripts/check-lane.mjs",
		"check:packed-install": "node scripts/check-packed-install.mjs",
		"check:gui": "node scripts/pnpm.mjs --filter pancode-gui typecheck && node scripts/pnpm.mjs --filter pancode-gui lint",
		"ci": "node scripts/ci.mjs",
		"release:build": "node scripts/release/build.mjs",
		"release:smoke": "node scripts/release/smoke.mjs",
		"install:local": "bash scripts/install-local.sh",
		"prepublishOnly": "node -e \"throw new Error('The publish job of .github/workflows/ci.yml publishes PanCode; see scripts/release/README.md.')\"",
		"skills:pin": "node --import tsx scripts/pin-skills.ts",
		"skills:check": "node --import tsx scripts/pin-skills.ts --check",
		"hooks:install": "node scripts/git-guard.mjs install",
		"hub:pin": "node --import tsx scripts/pin-hub.ts",
		"hub:check": "node --import tsx scripts/pin-hub.ts --check",
		"hub:review": "node --import tsx scripts/hub-review.ts",
		"kit:manifest": "node --import tsx scripts/kit-manifest.ts",
		"kit:check": "node --import tsx scripts/kit-manifest.ts --check",
		"economy:check": "node --import tsx scripts/check-economy-rates.ts",
		"pretest:full": "node scripts/check-dist.mjs",
		"test:full": "node scripts/ci-tests.mjs full",
		"test:package": "node scripts/ci-tests.mjs package",
		"test:gui:full": "node scripts/pnpm.mjs --filter pancode-gui test:full",
		"eval:onboarding": "node --import tsx scripts/eval-onboarding.ts",
		"eval:prompts": "python3 -B scripts/prompt-eval/run.py",
		"eval:prompts:selftest": "python3 -B scripts/prompt-eval/selftest.py",
		"test:maintenance": "node scripts/pnpm.mjs run test:file -- tests/extended/keyboard-routing.test.ts tests/extended/keyboard-drafts.test.ts"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "1.5.2",
		"@earendil-works/pi-ai": "1.5.2",
		"@earendil-works/pi-tui": "1.5.2",
		"@silvia-odwyer/photon-node": "0.3.4",
		"grok-mermaid": "0.2.2",
		"minimatch": "11.0.5",
		"smol-toml": "1.9.0",
		"undici": "7.30.2"
	},
	"devDependencies": {
		"@anthropic-ai/claude-agent-sdk": "0.3.292",
		"@github/copilot-sdk": "1.0.26",
		"@biomejs/biome": "2.5.1",
		"@types/node": "24.12.2",
		"@typescript/native": "npm:typescript@7.1.0-beta",
		"@vscode/tree-sitter-wasm": "0.3.1",
		"chalk": "5.6.2",
		"diff": "9.0.0",
		"esbuild": "0.28.1",
		"node-pty": "1.1.0",
		"ollama": "0.6.3",
		"rollup": "4.60.2",
		"tree-sitter-wasms": "0.1.13",
		"tsrs": "0.24.0-ts7.1.0-beta",
		"tsup": "8.5.1",
		"entities": "7.0.1",
		"marked": "18.0.11",
		"tsx": "4.23.15",
		"typebox": "1.3.0",
		"typescript": "npm:@typescript/typescript6@6.0.2",
		"uuid": "14.0.1",
		"yaml": "2.9.0"
	},
	"packageManager": "pnpm@10.34.5",
	"workspaces": [
		"apps/*",
		"packages/*"
	]
}
